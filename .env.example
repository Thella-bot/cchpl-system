APP_NAME=CCHPL 
APP_ENV=local 
APP_KEY= 
APP_DEBUG=true 
APP_URL=http://localhost:8000

LOG_CHANNEL=stack 
LOG_DEPRECATIONS_CHANNEL=null 
LOG_LEVEL=debug

DB_CONNECTION=mysql 
DB_HOST=127.0.0.1 
DB_PORT=3306 
DB_DATABASE=cchpl 
DB_USERNAME=root 
DB_PASSWORD=

BROADCAST_DRIVER=log 
CACHE_DRIVER=file 
FILESYSTEM_DISK=local 
QUEUE_CONNECTION=sync 
SESSION_DRIVER=file 
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1 
REDIS_PASSWORD=null 
REDIS_PORT=6379

MAIL_MAILER=smtp 
MAIL_HOST=mailpit 
MAIL_PORT=1025 
MAIL_USERNAME=null 
MAIL_PASSWORD=null 
MAIL_ENCRYPTION=null 
MAIL_FROM_ADDRESS="hello@example.com" 
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID= 
AWS_SECRET_ACCESS_KEY= 
AWS_DEFAULT_REGION=us-east-1 
AWS_BUCKET= 
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID= 
PUSHER_APP_KEY= 
PUSHER_APP_SECRET= 
PUSHER_HOST= 
PUSHER_PORT=443 
PUSHER_SCHEME=https 
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="APP_NAME" 
PUSHER_APP_KEY=
APP_KEY="{PUSHER_APP_KEY}"

# M-Pesa Daraja API Configuration - Safaricom Kenya / Vodacom Lesotho
# Get credentials from https://developer.safaricom.co.ke/
MPESA_SHORTCODE=174379                    # Your paybill/till business shortcode
MPESA_CONSUMER_KEY=your-mpesa-consumer-key-here
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret-here
MPESA_PASSKEY=your-mpesa-passkey-here     # STK Push passkey from M-Pesa portal
MPESA_ENVIRONMENT=sandbox                 # Set to 'production' for live transactions

# EcoCash API Configuration - Econet Lesotho
# Get credentials from Econet Lesotho Business Portal
ECOCASH_MERCHANT_ID=your-ecocash-merchant-id-here
ECOCASH_MERCHANT_KEY=your-ecocash-merchant-key-here
ECOCASH_ENVIRONMENT=sandbox               # Set to 'production' for live transactions

# Webhook Configuration - Configure in M-Pesa/EcoCash dashboards
# Must be publicly accessible HTTPS URLs
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mpesa
ECOCASH_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/ecocash